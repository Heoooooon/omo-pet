node_modules/
dist/
dist-overlay/
src-tauri/target/
src-tauri/gen/
.DS_Store
.codegraph

# Only the bundled original packs and the licensed OmO and Jabdori packs are tracked
# (scripts/check-bundle.mjs also fails the build if anything else lands in dist/packs).
public/packs/*
!public/packs/omo-cat/
!public/packs/omo/
!public/packs/jabdori/
!public/packs/dalli/
!public/packs/bara/
!public/packs/dochi/
!public/packs/rupa/
!public/packs/packs.json
.cache/

# sprite-gen run logs (contain local paths)
art/sprites/*/reports/
art/sprites/*/gen-set.log
art/sprites/*/raw/*.raw.png

# Python bytecode from running the art scripts
__pycache__/
